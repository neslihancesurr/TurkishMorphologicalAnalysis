# newdoc id = GUM_whow_elevator
# global.Entity = GRP-etype-infstat-centering-minspan-link-identity
# meta::author = Ethan Schoenhofen, Alex, Jeff and others (see URL)
# meta::dateCollected = 2016-09-19
# meta::dateCreated = 2009-06-26
# meta::dateModified = 2016-08-27
# meta::genre = whow
# meta::salientEntities = 1, 2, 12, 16, 19, 20, 31, 32, 44, 45, 58, 59, 69, 84, 90, 95, 97, 98
# meta::sourceURL = https://www.wikihow.com/Annoy-People-in-Elevators
# meta::speakerCount = 0
# meta::summary = This article suggests jokes and pranks to play on people in elevators, such as pushing all buttons, saying or singing 'ding' at every floor or announcing the floors, talking to your reflection in the mirror, standing in a corner facing the wall, dancing, putting a Lego city or Twister mat on the floor, or pretending to have lost a tarantula, snake or scorpion in the elevator.
# meta::title = How to Annoy People in Elevators
